{
  "name": "truthgate",
  "version": "0.1.0",
  "description": "Verify agent-written code against user-approved specs. Honest verdicts, never more than was established.",
  "type": "module",
  "bin": { "truthgate": "dist/cli.js" },
  "files": ["dist", "assets", "src/lang/**/templates"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "e2e": "node --test \"test/e2e/**/*.e2e.ts\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fast-check": "4.10.2",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
