{
  "name": "truthgate",
  "version": "0.3.0",
  "description": "Verify agent-written code against user-approved specs. Honest verdicts, never more than was established.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrAzyScreamx/truthgate.git"
  },
  "homepage": "https://github.com/CrAzyScreamx/truthgate#readme",
  "bugs": {
    "url": "https://github.com/CrAzyScreamx/truthgate/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "property-testing",
    "verification",
    "mcp",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "truthgate": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "src/lang/*/templates/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "e2e": "node --import ./test/setup.ts --test \"test/e2e/**/*.e2e.ts\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fast-check": "4.10.2",
    "smol-toml": "1.9.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
